  {
   "id": "126c99d0-5aab-465c-9e87-dcd8b2f4f894",
   "name": "WhatsApp → Feedback",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    448,
    384
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Meta WhatsApp Cloud API webhook -> feedback items. Only text replies; status updates are ignored.\n// The sender number (from) is NOT kept: the desk needs the words, not the person (DPDP minimum data).\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  if (!body || body.object !== 'whatsapp_business_account') continue;\n  for (const entry of body.entry || []) for (const ch of entry.changes || []) {\n    for (const m of (ch.value && ch.value.messages) || []) {\n      const text = m.type === 'text' ? m.text?.body : m.type === 'button' ? m.button?.text : m.type === 'interactive' ? (m.interactive?.button_reply?.title || m.interactive?.list_reply?.title) : '';\n      if (!text) continue;\n      const ts = Number(m.timestamp);\n      out.push({ json: { source: 'whatsapp', product: '', text: String(text), created: ts ? new Date(ts * 1000).toISOString() : new Date().toISOString() } });\n    }\n  }\n}\nreturn out;\n"
   }
  },
  {
   "id": "d01b1024-ef58-4304-bed2-2a782d0fe9ad",
   "name": "Sticky Note 862172ac",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -32,
