   "position": [
    224,
    0
   ],
   "parameters": {
    "mode": "manual",
    "includeOtherFields": false,
    "assignments": {
     "assignments": [
      {
       "id": "t1",
       "name": "source",
       "type": "string",
       "value": "telegram"
      },
      {
       "id": "t2",
       "name": "product",
       "type": "string",
       "value": "={{ ((($json.message?.text || '').match(/#([a-z-]+)/i)) || ['', ''])[1] }}"
      },
      {
       "id": "t3",
       "name": "text",
       "type": "string",
       "value": "={{ String($json.message?.text || '').replace(/^\\/feedback(@\\w+)?\\s*/i, '') }}"
      },
      {
       "id": "t4",
       "name": "created",
       "type": "string",
       "value": "={{ $json.message?.date ? DateTime.fromSeconds($json.message.date).toISO() : $now.toISO() }}"
      },
      {
       "id": "t5",
       "name": "isCommand",
       "type": "boolean",
       "value": "={{ /^\\/(?!feedback)/i.test(String($json.message?.text || '')) }}"
      }
     ]
    }
   }
