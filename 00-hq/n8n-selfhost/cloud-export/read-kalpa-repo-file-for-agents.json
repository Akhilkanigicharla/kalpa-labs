   "parameters": {
    "method": "GET",
    "url": "={{ 'https://api.github.com/repos/Akhilkanigicharla/kalpa-labs/contents/' + String($json.path || '00-hq/SERVICE-DESK.md').replace(/^\\/+/, '').replace(/\\.\\./g, '') + '?ref=main' }}",
