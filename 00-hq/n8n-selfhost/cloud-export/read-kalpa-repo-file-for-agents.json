  {
   "id": "8890584d-5d09-48b8-a2aa-74a1123aa41e",
   "name": "Trim",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    448,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const r = $input.first().json;\nconst code = Number(r.statusCode);\nlet body = typeof r.body === 'string' ? r.body : (typeof r.data === 'string' ? r.data : JSON.stringify(r.body || r.data || ''));\nif (code !== 200) return [{ json: { content: 'Could not read that file (HTTP ' + code + '). Useful paths: README.md, 00-hq/SERVICE-DESK.md, 00-hq/ROADMAP.md, 00-hq/audit/facts.md, 01-botbhai/botbhai/README.md, 0N-<world>/README.md' } }];\nconst cut = body.length > 6000;\nreturn [{ json: { content: body.slice(0, 6000) + (cut ? '\\n...[trimmed at 6000 chars]' : '') } }];"
   }
  }
 ],
