   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const j = $json;\nconst name = String(j.name || '').trim();\nconst digits = String(j.phone || '').replace(/\\D/g, '');\nconst missing = [];\nif (!name || /[\\[\\]<>{}]/.test(name) || /^(name|visitor|user|unknown|n\\/a)$/i.test(name)) missing.push('real name');\nif (digits.length < 10 || digits.length > 13 || /^(\\d)\\1+$/.test(digits)) missing.push('a valid 10-digit phone/WhatsApp number');\nif (j.consent_said_yes !== true && String(j.consent_said_yes).toLowerCase() !== 'true') missing.push('the visitor saying YES to being contacted');\nreturn { json: { ok: missing.length === 0, missing: missing.join(', '), name, phone: digits.length === 10 ? '+91' + digits : '+' + digits,\n  business: String(j.business || '').slice(0, 200), interest: String(j.interest || 'other').slice(0, 40), best_time: String(j.best_time || 'any').slice(0, 80),\n  language: String(j.language || '').slice(0, 10), notes: String(j.notes || '').slice(0, 400) } };"
   }
  },
