   "name": "Compact Results",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    448,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const all = $input.all().map(i => i.json);\nlet res = [];\nfor (const j of all) {\n  if (Array.isArray(j?.web?.results)) res = res.concat(j.web.results);\n  else if (j?.url && j?.title) res.push(j);\n}\nconst lines = res.slice(0, 5).map((r, i) => (i + 1) + '. ' + String(r.title || '').slice(0, 120) + ' | ' + r.url + ' | ' + String(r.description || '').replace(/<[^>]+>/g, '').slice(0, 300));\nreturn [{ json: { results: lines.length ? lines.join('\\n') : 'No results (or search failed). Try a different, more specific query.' } }];"
   }
  }
