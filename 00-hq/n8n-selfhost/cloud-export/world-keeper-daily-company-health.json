  {
   "id": "5be114ee-1481-4b60-91de-cfdbde1f621e",
   "name": "Build World Report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    896,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const runs = (($('GitHub CI Runs').first().json.workflow_runs) || []).filter(r => !/ai-gateway/i.test(String(r.path || '')));\nconst siteRes = $('Company Site Up?').first().json;\nconst siteOk = Number(siteRes.statusCode) === 200;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst realNew = rows.filter(r => r.status === 'new' && !/test|\\[/i.test(String(r.name)));\nconst latest = {};\nfor (const r of runs) { if (!latest[r.name]) latest[r.name] = r; }\nconst MAP = [[/botbhai|leadfinder|salon/i,'b1 BotBhai'],[/jobcard/i,'b2 JobCard'],[/kits|gate/i,'b3 Kits'],[/lifeboat|extension/i,'b4 Tab Lifeboat'],[/deals|calculator/i,'b5 Deals'],[/finops|ledger/i,'b6 Ledger Peaks'],[/trading|backtest/i,'b7 Trading Lab']];\nconst worldOf = (n, p) => { const s = n + ' ' + (p || ''); const m = MAP.find(([re]) => re.test(s)); return m ? m[1] : 'HQ'; };\nconst lines = []; let red = 0;\nfor (const [name, r] of Object.entries(latest)) {\n  const ok = r.conclusion === 'success'; const pending = !r.conclusion;\n  if (!ok && !pending) red++;\n  lines.push((ok ? 'OK ' : pending ? '.. ' : 'RED ') + worldOf(name, r.path) + ': ' + name + (ok || pending ? '' : ' -> ' + r.conclusion + ' ' + r.html_url));\n}\nlines.sort();\nconst today = new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\nconst summary = [\n  'World Keeper ' + today + ': ' + (red ? red + ' red check(s)' : 'all checks green') + '; site ' + (siteOk ? 'UP' : 'DOWN (' + siteRes.statusCode + ')') + '; new callback leads: ' + realNew.length + '.',\n  ...realNew.slice(0, 5).map(l => 'CALL: ' + l.name + ' ' + l.phone + ' (' + l.interest + ', ' + l.best_time + ')'),\n  ...lines\n].join('\\n');\nreturn [{ json: { title: 'World Keeper ' + today, category: 'Health', stream: 'HQ', summary, source: 'n8n World Keeper', red, siteOk, newLeads: realNew.length } }];"
   }
  },
