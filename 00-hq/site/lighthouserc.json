{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2
        },
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/index\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 51200
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "errors-in-console": "error",
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 51200
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "errors-in-console": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./_lh_report"
    }
  }
}
