{
  "ci": {
    "collect": {
      "staticDistDir": "./_lh_site/site",
      "url": ["http://localhost/index.html", "http://localhost/salon-in-jubilee-hills.html"],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "onlyCategories": ["performance", "accessibility", "best-practices", "seo"] }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "color-contrast": "error",
        "errors-in-console": "error"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./_lh_report" }
  }
}
