      { "id": "hi-c-kha", "script": "ख", "translit": "kha", "en": "k with a puff of air", "example": { "script": "खरगोश", "translit": "khargosh", "en": "rabbit" } },
      { "id": "hi-c-ga", "script": "ग", "translit": "ga", "en": "g sound", "example": { "script": "गाय", "translit": "gaay", "en": "cow" } },
      { "id": "hi-c-gha", "script": "घ", "translit": "gha", "en": "g with a puff of air", "example": { "script": "घर", "translit": "ghar", "en": "house" } },
      { "id": "hi-c-cha", "script": "च", "translit": "cha", "en": "ch sound", "example": { "script": "चूहा", "translit": "chuuhaa", "en": "mouse" } },
