  "phrases": [
    { "id": "hi-p-01", "script": "मेरा नाम ___ है।", "translit": "meraa naam ___ hai.", "en": "My name is ___." },
    { "id": "hi-p-02", "script": "तुम्हारा नाम क्या है?", "translit": "tumhaaraa naam kyaa hai?", "en": "What is your name?" },
    { "id": "hi-p-03", "script": "आप कैसे हैं?", "translit": "aap kaise hain?", "en": "How are you? (polite)" },
    { "id": "hi-p-04", "script": "मैं ठीक हूँ।", "translit": "main Thiik huun.", "en": "I am fine." },
    { "id": "hi-p-05", "script": "मुझे भूख लगी है।", "translit": "mujhe bhuukh lagii hai.", "en": "I am hungry." },
    { "id": "hi-p-06", "script": "मुझे पानी चाहिए।", "translit": "mujhe paanii chaahiye.", "en": "I want water." },
    { "id": "hi-p-07", "script": "यह क्या है?", "translit": "yah kyaa hai?", "en": "What is this?" },
    { "id": "hi-p-08", "script": "मुझे नहीं पता।", "translit": "mujhe nahiin pataa.", "en": "I don't know." },
    { "id": "hi-p-09", "script": "मुझे यह पसंद है।", "translit": "mujhe yah pasand hai.", "en": "I like this." },
    { "id": "hi-p-10", "script": "मुझे नींद आ रही है।", "translit": "mujhe niind aa rahii hai.", "en": "I am sleepy." },
    { "id": "hi-p-11", "script": "चलो खेलते हैं।", "translit": "chalo khelte hain.", "en": "Let's play." },
    { "id": "hi-p-12", "script": "यह बहुत अच्छा है।", "translit": "yah bahut achchhaa hai.", "en": "This is very good." },
    { "id": "hi-p-13", "script": "फिर से बोलिए।", "translit": "phir se boliye.", "en": "Please say it again." },
    { "id": "hi-p-14", "script": "मेरी मदद कीजिए।", "translit": "merii madad kiijiye.", "en": "Please help me." },
    { "id": "hi-p-15", "script": "शुभ रात्रि।", "translit": "shubh raatri.", "en": "Good night." },
    { "id": "hi-p-16", "script": "दादी, आप कैसी हैं?", "translit": "daadii, aap kaisii hain?", "en": "Grandma, how are you?" },
    { "id": "hi-p-17", "script": "मैं स्कूल जा रहा हूँ।", "translit": "main skuul jaa rahaa huun.", "en": "I am going to school.", "note": "Boy says rahaa (रहा); girl says rahii (रही)." },
    { "id": "hi-p-18", "script": "आपने खाना खाया?", "translit": "aapne khaanaa khaayaa?", "en": "Did you eat? (polite)" },
    { "id": "hi-p-19", "script": "आइए, बैठिए।", "translit": "aaiye, baiThiye.", "en": "Please come, sit down." },
    { "id": "hi-p-20", "script": "बाय, फिर मिलेंगे।", "translit": "baay, phir milenge.", "en": "Bye, see you again." }
  ]
}
