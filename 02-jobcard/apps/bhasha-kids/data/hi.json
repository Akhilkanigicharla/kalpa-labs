  "transliteration_note": "Simple learner spelling: doubled vowels are long (aa, ii, uu); capital T, D, N are tongue-curled (retroflex) sounds; ch as in 'chair'; n before a consonant or at the end can be nasal. Not ISO 15919.",
  "letters": {
    "vowels": [
      { "id": "hi-v-a", "script": "अ", "translit": "a", "en": "short a, as in 'about'", "example": { "script": "अनार", "translit": "anaar", "en": "pomegranate" } },
      { "id": "hi-v-aa", "script": "आ", "translit": "aa", "en": "long aa, as in 'father'", "example": { "script": "आम", "translit": "aam", "en": "mango" } },
      { "id": "hi-v-i", "script": "इ", "translit": "i", "en": "short i, as in 'sit'", "example": { "script": "इमली", "translit": "imlii", "en": "tamarind" } },
      { "id": "hi-v-ii", "script": "ई", "translit": "ii", "en": "long ii, as in 'see'" },
      { "id": "hi-v-u", "script": "उ", "translit": "u", "en": "short u, as in 'put'", "example": { "script": "उल्लू", "translit": "ulluu", "en": "owl" } },
      { "id": "hi-v-uu", "script": "ऊ", "translit": "uu", "en": "long uu, as in 'moon'", "example": { "script": "ऊन", "translit": "uun", "en": "wool" } },
      { "id": "hi-v-ri", "script": "ऋ", "translit": "ri", "en": "ri, as in 'rich' (mostly in Sanskrit words)" },
      { "id": "hi-v-e", "script": "ए", "translit": "e", "en": "e, as in 'café'", "example": { "script": "एक", "translit": "ek", "en": "one" } },
      { "id": "hi-v-ai", "script": "ऐ", "translit": "ai", "en": "ai, as in 'bat' (said long)" },
      { "id": "hi-v-o", "script": "ओ", "translit": "o", "en": "o, as in 'go'" },
      { "id": "hi-v-au", "script": "औ", "translit": "au", "en": "au, as in 'caught'" },
      { "id": "hi-v-am", "script": "अं", "translit": "am", "en": "a with a nasal sound" },
      { "id": "hi-v-ah", "script": "अः", "translit": "ah", "en": "a with a breath h sound" }
