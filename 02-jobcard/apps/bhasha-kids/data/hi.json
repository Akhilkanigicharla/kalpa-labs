      { "id": "hi-c-bha", "script": "भ", "translit": "bha", "en": "b with a puff of air", "example": { "script": "भालू", "translit": "bhaaluu", "en": "bear" } },
      { "id": "hi-c-ma", "script": "म", "translit": "ma", "en": "m sound", "example": { "script": "मछली", "translit": "machhlii", "en": "fish" } },
      { "id": "hi-c-ya", "script": "य", "translit": "ya", "en": "y sound" },
      { "id": "hi-c-ra", "script": "र", "translit": "ra", "en": "r sound", "example": { "script": "रोटी", "translit": "roTii", "en": "roti (flatbread)" } },
      { "id": "hi-c-la", "script": "ल", "translit": "la", "en": "l sound" },
      { "id": "hi-c-va", "script": "व", "translit": "va", "en": "v / w sound" },
      { "id": "hi-c-sha", "script": "श", "translit": "sha", "en": "sh sound", "example": { "script": "शेर", "translit": "sher", "en": "lion" } },
      { "id": "hi-c-Sha", "script": "ष", "translit": "Sha", "en": "sh, tongue curled back (mostly in Sanskrit words)" },
      { "id": "hi-c-sa", "script": "स", "translit": "sa", "en": "s sound", "example": { "script": "सेब", "translit": "seb", "en": "apple" } },
