  "transliteration_note": "Simple learner spelling: doubled vowels are long (aa, ii, uu, ee, oo); capital T, D, N, L are tongue-curled (retroflex) sounds; ch as in 'chair'. Not ISO 15919.",
  "letters": {
    "vowels": [
      { "id": "te-v-a", "script": "అ", "translit": "a", "en": "short a, as in 'about'", "example": { "script": "అమ్మ", "translit": "amma", "en": "mother" } },
      { "id": "te-v-aa", "script": "ఆ", "translit": "aa", "en": "long aa, as in 'father'", "example": { "script": "ఆవు", "translit": "aavu", "en": "cow" } },
      { "id": "te-v-i", "script": "ఇ", "translit": "i", "en": "short i, as in 'sit'", "example": { "script": "ఇల్లు", "translit": "illu", "en": "house" } },
      { "id": "te-v-ii", "script": "ఈ", "translit": "ii", "en": "long ii, as in 'see'", "example": { "script": "ఈగ", "translit": "iiga", "en": "housefly" } },
      { "id": "te-v-u", "script": "ఉ", "translit": "u", "en": "short u, as in 'put'" },
      { "id": "te-v-uu", "script": "ఊ", "translit": "uu", "en": "long uu, as in 'moon'", "example": { "script": "ఊయల", "translit": "uuyala", "en": "swing (cradle)" } },
      { "id": "te-v-ru", "script": "ఋ", "translit": "ru", "en": "ru, as in 'ruby' (mostly in Sanskrit words)" },
      { "id": "te-v-e", "script": "ఎ", "translit": "e", "en": "short e, as in 'pen'", "example": { "script": "ఎరుపు", "translit": "erupu", "en": "red" } },
      { "id": "te-v-ee", "script": "ఏ", "translit": "ee", "en": "long ee, as in 'café'", "example": { "script": "ఏనుగు", "translit": "eenugu", "en": "elephant" } },
      { "id": "te-v-ai", "script": "ఐ", "translit": "ai", "en": "ai, as in 'eye'", "example": { "script": "ఐదు", "translit": "aidu", "en": "five" } },
      { "id": "te-v-o", "script": "ఒ", "translit": "o", "en": "short o", "example": { "script": "ఒకటి", "translit": "okaTi", "en": "one" } },
      { "id": "te-v-oo", "script": "ఓ", "translit": "oo", "en": "long oo, as in 'go'" },
      { "id": "te-v-au", "script": "ఔ", "translit": "au", "en": "au, as in 'cow'" },
      { "id": "te-v-am", "script": "అం", "translit": "am", "en": "a with a nasal m sound" },
      { "id": "te-v-aha", "script": "అః", "translit": "aha", "en": "a with a breath h sound" }
    ],
    "consonants": [
      { "id": "te-c-ka", "script": "క", "translit": "ka", "en": "k sound", "example": { "script": "కుక్క", "translit": "kukka", "en": "dog" } },
      { "id": "te-c-kha", "script": "ఖ", "translit": "kha", "en": "k with a puff of air" },
      { "id": "te-c-ga", "script": "గ", "translit": "ga", "en": "g sound", "example": { "script": "గుర్రం", "translit": "gurram", "en": "horse" } },
      { "id": "te-c-gha", "script": "ఘ", "translit": "gha", "en": "g with a puff of air" },
      { "id": "te-c-cha", "script": "చ", "translit": "cha", "en": "ch sound", "example": { "script": "చేప", "translit": "cheepa", "en": "fish" } },
      { "id": "te-c-ja", "script": "జ", "translit": "ja", "en": "j sound" },
      { "id": "te-c-Ta", "script": "ట", "translit": "Ta", "en": "hard t, tongue curled back" },
      { "id": "te-c-Da", "script": "డ", "translit": "Da", "en": "hard d, tongue curled back" },
      { "id": "te-c-Na", "script": "ణ", "translit": "Na", "en": "n, tongue curled back" },
      { "id": "te-c-ta", "script": "త", "translit": "ta", "en": "soft t, tongue on teeth", "example": { "script": "తల", "translit": "tala", "en": "head" } },
      { "id": "te-c-da", "script": "ద", "translit": "da", "en": "soft d, tongue on teeth", "example": { "script": "దీపం", "translit": "diipam", "en": "lamp" } },
      { "id": "te-c-na", "script": "న", "translit": "na", "en": "n sound", "example": { "script": "నోరు", "translit": "nooru", "en": "mouth" } },
      { "id": "te-c-pa", "script": "ప", "translit": "pa", "en": "p sound", "example": { "script": "పులి", "translit": "puli", "en": "tiger" } },
      { "id": "te-c-pha", "script": "ఫ", "translit": "pha", "en": "p with a puff of air" },
      { "id": "te-c-ba", "script": "బ", "translit": "ba", "en": "b sound", "example": { "script": "బల్ల", "translit": "balla", "en": "table" } },
      { "id": "te-c-bha", "script": "భ", "translit": "bha", "en": "b with a puff of air" },
      { "id": "te-c-ma", "script": "మ", "translit": "ma", "en": "m sound", "example": { "script": "ముక్కు", "translit": "mukku", "en": "nose" } },
      { "id": "te-c-ya", "script": "య", "translit": "ya", "en": "y sound" },
      { "id": "te-c-ra", "script": "ర", "translit": "ra", "en": "r sound", "example": { "script": "రెండు", "translit": "renDu", "en": "two" } },
      { "id": "te-c-la", "script": "ల", "translit": "la", "en": "l sound" },
      { "id": "te-c-va", "script": "వ", "translit": "va", "en": "v / w sound" },
      { "id": "te-c-sha", "script": "శ", "translit": "sha", "en": "sh sound" },
      { "id": "te-c-Sha", "script": "ష", "translit": "Sha", "en": "sh, tongue curled back" },
      { "id": "te-c-sa", "script": "స", "translit": "sa", "en": "s sound" },
      { "id": "te-c-ha", "script": "హ", "translit": "ha", "en": "h sound" },
      { "id": "te-c-La", "script": "ళ", "translit": "La", "en": "l, tongue curled back" }
    ]
  },
