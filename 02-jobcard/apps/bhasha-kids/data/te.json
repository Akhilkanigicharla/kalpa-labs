  "phrases": [
    { "id": "te-p-01", "script": "నా పేరు ___.", "translit": "naa peeru ___.", "en": "My name is ___." },
    { "id": "te-p-02", "script": "నీ పేరు ఏమిటి?", "translit": "nii peeru eemiTi?", "en": "What is your name?" },
    { "id": "te-p-03", "script": "ఎలా ఉన్నావు?", "translit": "elaa unnaavu?", "en": "How are you?" },
    { "id": "te-p-04", "script": "నేను బాగున్నాను.", "translit": "neenu baagunnaanu.", "en": "I am fine." },
    { "id": "te-p-05", "script": "నాకు ఆకలిగా ఉంది.", "translit": "naaku aakaligaa undi.", "en": "I am hungry." },
    { "id": "te-p-06", "script": "నాకు నీళ్ళు కావాలి.", "translit": "naaku niiLLu kaavaali.", "en": "I want water." },
    { "id": "te-p-07", "script": "ఇది ఏమిటి?", "translit": "idi eemiTi?", "en": "What is this?" },
    { "id": "te-p-08", "script": "నాకు తెలియదు.", "translit": "naaku teliyadu.", "en": "I don't know." },
    { "id": "te-p-09", "script": "నాకు ఇష్టం.", "translit": "naaku ishTam.", "en": "I like it." },
    { "id": "te-p-10", "script": "నాకు నిద్ర వస్తోంది.", "translit": "naaku nidra vastoondi.", "en": "I am sleepy." },
    { "id": "te-p-11", "script": "నేను ఆడుకుంటాను.", "translit": "neenu aaDukunTaanu.", "en": "I will play." },
    { "id": "te-p-12", "script": "ఇది చాలా బాగుంది.", "translit": "idi chaalaa baagundi.", "en": "This is very nice." },
    { "id": "te-p-13", "script": "మళ్ళీ చెప్పండి.", "translit": "maLLii cheppanDi.", "en": "Please say it again." },
    { "id": "te-p-14", "script": "నాకు సహాయం చెయ్యండి.", "translit": "naaku sahaayam cheyyanDi.", "en": "Please help me." },
    { "id": "te-p-15", "script": "శుభ రాత్రి.", "translit": "shubha raatri.", "en": "Good night." },
    { "id": "te-p-16", "script": "తాతయ్యా, బాగున్నారా?", "translit": "taatayyaa, baagunnaaraa?", "en": "Grandpa, are you well?" },
    { "id": "te-p-17", "script": "నేను బడికి వెళ్తున్నాను.", "translit": "neenu baDiki veLtunnaanu.", "en": "I am going to school." },
    { "id": "te-p-18", "script": "అన్నం తిన్నావా?", "translit": "annam tinnaavaa?", "en": "Did you eat? (a common caring greeting)" },
    { "id": "te-p-19", "script": "రండి, కూర్చోండి.", "translit": "ranDi, kuurchoonDi.", "en": "Please come, sit down." },
    { "id": "te-p-20", "script": "బై, మళ్ళీ కలుద్దాం.", "translit": "bai, maLLii kaluddaam.", "en": "Bye, see you again." }
  ]
}
