{
  "name": "tab-lifeboat",
  "description": "Save all tabs and tab groups in one click, with automatic snapshots so a crash, update or reinstall never wipes them.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/save-restore.e2e.mjs",
    "lint": "biome lint lib entrypoints tests",
    "postinstall": "wxt prepare",
    "test:screens": "npm run build && node tests/e2e/screens.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/anek-latin": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/rozha-one": "5.3.0",
    "idb": "8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "5.0.4",
    "web-ext": "^10.5.0",
    "wxt": "0.21.4"
  }
}
