---
// One pricing tier. Full price shown once; no fake urgency (Dark Patterns Guidelines 2023).
import type { Tier } from "../lib/kits";
import { priceLabel } from "../lib/kits";
interface Props { tier: Tier; kit: string; featured?: boolean }
const { tier, kit, featured = false } = Astro.props;
const early = tier.earlyBird && tier.earlyBird.active && tier.buyUrl ? tier.earlyBird : null;
---
<article class:list={["tier", { featured }]}>
  <h3>{tier.name}</h3>
  <p class="price">{early ? <><s>{priceLabel(tier)}</s> ₹{early.price}</> : priceLabel(tier)}</p>
  {early && <p class="note">Early-bird price for the first {early.buyers} buyers. We change this page the moment they're gone.</p>}
  <ul>{tier.gets.map((g) => <li>{g}</li>)}</ul>
  {tier.price === 0
    ? <a class="btn ghost" href={tier.buyUrl || "#lite"}>{tier.buyUrl ? "Get the free Lite sheet" : "Free Lite sheet: opening soon"}</a>
    : tier.buyUrl
      ? <a class="btn" href={tier.buyUrl} rel="noopener">Buy {tier.name}: {early ? `₹${early.price}` : priceLabel(tier)}</a>
      : <span class="btn off" aria-disabled="true">Opens soon</span>}
</article>
<style>
  .tier { background: var(--panel); border: 1px solid var(--rule); border-radius: var(--r-l); padding: 16px; display: flex; flex-direction: column; gap: 8px; box-shadow: var(--shadow); }
  .tier.featured { border: 2px solid var(--gold); }
  h3 { margin: 0; font: 600 17px var(--f-body); }
  .price { margin: 0; font: 400 32px/1.1 var(--f-display); }
  .price s { color: var(--muted); font-size: 20px; margin-right: 6px; }
  .note { margin: 0; color: var(--muted); font-size: 13px; }
  ul { margin: 0; padding-left: 16px; flex: 1; } li { margin-bottom: 4px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; border-radius: 999px; padding: 0 16px; background: var(--accent); color: var(--accent-fg); text-decoration: none; font-weight: 600; text-align: center; }
  .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--rule); }
  .btn.off { background: var(--soft); color: var(--muted); cursor: default; }
</style>
