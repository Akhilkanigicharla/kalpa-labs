---
import Base from "../layouts/Base.astro";
import Calculator from "../components/Calculator.astro";
import { CALCS, bySlug } from "../lib/calcs";
export function getStaticPaths() { return CALCS.map((c) => ({ params: { calc: c.slug } })); }
const lang = "en";
const c = bySlug(Astro.params.calc!);
const faq = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faqs.map((f) => ({ "@type": "Question", name: f.q[lang], acceptedAnswer: { "@type": "Answer", text: f.a[lang] } })) };
const app = { "@context": "https://schema.org", "@type": "WebApplication", name: c.title[lang], applicationCategory: "FinanceApplication", operatingSystem: "Any", offers: { "@type": "Offer", price: "0", priceCurrency: "INR" } };
---
<Base title={`${c.title[lang]} | Free`} description={c.blurb[lang]} lang={lang} path={`/${c.slug}/`} jsonld={[app, faq]}>
  <h1>{c.title[lang]}</h1>
  <p class="muted">{c.blurb[lang]}</p>
  <Calculator slug={c.slug} lang={lang} />
  <h2>Questions</h2>
  {c.faqs.map((f) => <details><summary>{f.q[lang]}</summary><p>{f.a[lang]}</p></details>)}
  <p><a href="/">All calculators</a></p>
</Base>
<style>details { border-bottom: 1px solid var(--rule); padding: 10px 0; } summary { cursor: pointer; font-weight: 600; min-height: 32px; }</style>
