---
import Base from "../layouts/Base.astro";
import { CALCS } from "../lib/calcs";
const lang = "en";
---
<Base title="Free money calculators for India: tax 2026-27, GST, SIP, EMI, gratuity" description="Income tax (new vs old regime, 2026-27), salary in hand, GST, gratuity, SIP, EMI, FD, RD, PPF and HRA calculators in English and Telugu." lang={lang} path="/">
  <h1>Money calculators for India</h1>
  <p class="muted">Tax year 2026-27 rules. English and Telugu. No sign-up.</p>
  <ul class="grid">{CALCS.map((c) => <li><a class="card tile" href={`/${c.slug}/`}><strong>{c.title[lang]}</strong><span class="muted">{c.blurb[lang]}</span></a></li>)}</ul>
</Base>
<style>.grid { list-style: none; padding: 0; display: grid; gap: 12px; } .tile { display: grid; gap: 4px; text-decoration: none; color: var(--fg); border-top: 4px solid var(--l5); } @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }</style>
