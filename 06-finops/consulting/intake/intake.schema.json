{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalpa-labs/consulting/intake.schema.json",
  "title": "Kalpa Labs consulting client intake",
  "type": "object",
  "required": ["company", "ai_systems", "markets", "governance", "goals", "consent"],
  "properties": {
    "synthetic": {"type": "boolean"},
    "company": {
      "type": "object",
      "required": ["name", "country", "contact_name", "contact_email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "website": {"type": "string"},
        "city": {"type": "string"},
        "country": {"type": "string", "minLength": 2},
        "sells": {"type": "string"},
        "team_size": {"type": "integer", "minimum": 1},
        "contact_name": {"type": "string", "minLength": 1},
        "contact_role": {"type": "string"},
        "contact_email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}
      }
    },
    "ai_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "status", "customer_facing", "personal_data"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "built": {"type": "string", "enum": ["in-house", "bought", "both"]},
          "providers": {"type": "array", "items": {"type": "string"}},
          "models": {"type": "array", "items": {"type": "string"}},
          "affected": {"type": "array", "items": {"type": "string", "enum": ["staff", "customers", "children", "public"]}},
          "customer_facing": {"type": "boolean"},
          "discloses_ai": {"type": "boolean"},
          "personal_data": {"type": "boolean"},
          "personal_data_kinds": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["idea", "pilot", "live", "retired"]}
        }
      }
    },
    "spend": {
      "type": "object",
      "properties": {
        "monthly_amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "enum": ["INR", "USD", "EUR", "GBP"]},
        "providers": {"type": "array", "items": {"type": "string"}},
        "usage_export_available": {"type": "boolean"},
        "tags_by_feature": {"type": "boolean"},
        "uses_prompt_caching": {"type": "boolean"},
        "uses_response_cache": {"type": "boolean"},
        "uses_batch": {"type": "boolean"}
      }
    },
    "markets": {
      "type": "object",
      "required": ["user_countries"],
      "properties": {
        "user_countries": {"type": "array", "items": {"type": "string", "enum": ["IN", "EU", "US", "UK", "other"]}},
        "industry_rules": {"type": "array", "items": {"type": "string"}},
        "enterprise_asks_ai_governance": {"type": "boolean"}
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "ai_policy": {"type": "string", "enum": ["yes", "draft", "no"]},
        "inventory": {"type": "boolean"},
        "risk_register": {"type": "boolean"},
        "ai_risk_owner": {"type": "string"},
        "injection_tested": {"type": "boolean"},
        "privacy_notice_names_ai": {"type": "boolean"},
        "grievance_contact": {"type": "boolean"},
        "certifications": {"type": "array", "items": {"type": "string"}},
        "wants_iso42001": {"type": "boolean"}
      }
    },
    "goals": {
      "type": "object",
      "required": ["packages"],
      "properties": {
        "packages": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["P1", "P2", "P3"]}},
        "top_worry": {"type": "string"},
        "deadline": {"type": "string"}
      }
    },
    "consent": {
      "type": "object",
      "required": ["data_processing", "case_study"],
      "properties": {
        "data_processing": {"type": "boolean", "const": true},
        "delete_after_days": {"type": "integer", "minimum": 1},
        "case_study": {"type": "string", "enum": ["yes", "with review", "no"]}
      }
    }
  }
}
