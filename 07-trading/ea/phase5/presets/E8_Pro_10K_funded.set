; Kalpa gold EA - E8 Markets "E8 Pro" $10K, funded (Performance) stage: no target, keep the daily cap (A337, rules from E8 help centre 22 Nov 2026)
; E8 Pro: 8% target, only 2%/day counts, 2.5% daily drawdown, 8% static max loss, metals 1:15.
inp_Stage=3
inp_Program=8
inp_AccountSize=10000
inp_MinProfitDays=0
inp_FirmDailyLossPct=2.5
inp_FirmMaxLossPct=8
inp_PropDailyStopPct=1.5
inp_DailyProfitCapPct=2.0
inp_MetalLeverage=15
inp_ProfitTarget=0
inp_EquityFloor=0
inp_MixRiskPct=0.30
inp_RiskPct=0.30
; Audit 26 Nov 2026: a weekend gap is booked against Monday's 2.5% daily limit, so keep the worst-case gap loss inside the EA's 1.5% daily stop (default 3% > 2.5%).
inp_WeekendLossBudgetPct=1.5
; Recheck 27 Nov 2026: E8 breaches on BALANCE as well as equity (help centre, Daily Drawdown). The EA's 1.5% stop watches equity,
; so a closed loss can pass $250 while open winners hide it. Cap the day's closed loss at $150 (default $300 > E8's $250).
inp_DailyLossLimit=150
; A347: send real orders (the EA's own default is a log-only dry run)
inp_DryRun=false
; A347: after the first payout E8 lifts its loss line to $10,000; the EA lifts its floor to $10,100 by itself
inp_FloorAfterPayoutPct=101
